// Prisma schema — Liba CRM + Liba Finance ERP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── CRM models ───────────────────────────────────────────────

model Company {
  id            String   @id @default(cuid())
  userId        String
  name          String
  industry      String
  website       String?
  employees     Int      @default(0)
  annualRevenue Decimal  @default(0) @db.Decimal(14, 2)
  city          String?
  country       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@index([userId])
  @@index([name])
  @@index([industry])
}

model Contact {
  id        String        @id @default(cuid())
  userId    String
  firstName String
  lastName  String
  email     String
  phone     String?
  title     String?
  status    ContactStatus @default(LEAD)
  companyId String?
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deals Deal[]

  @@unique([userId, email])
  @@index([userId])
  @@index([lastName])
  @@index([status])
  @@index([companyId])
}

enum ContactStatus {
  LEAD
  QUALIFIED
  CUSTOMER
  CHURNED
}

model Deal {
  id                String    @id @default(cuid())
  userId            String
  title             String
  value             Decimal   @default(0) @db.Decimal(14, 2)
  stage             DealStage @default(PROSPECTING)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  companyId         String?
  contactId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([stage])
  @@index([companyId])
  @@index([contactId])
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// ─── Calendar ─────────────────────────────────────────────────

model Meeting {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  meetingLink String        @unique @default(cuid())
  status      MeetingStatus @default(SCHEDULED)
  timezone    String        @default("America/Sao_Paulo")
  isAllDay    Boolean       @default(false)
  location    String?
  color       String?
  repeatRule  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendees MeetingAttendee[]

  @@index([userId])
  @@index([userId, startAt])
  @@index([meetingLink])
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MeetingAttendee {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  responseStatus  String   @default("INVITED")
  canInviteOthers Boolean  @default(false)
  canSeeGuestList Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([meetingId])
}

// ─── ERP — shared ─────────────────────────────────────────────

model Party {
  id                  String     @id @default(cuid())
  userId              String
  personType          PersonType @default(PESSOA_JURIDICA)
  document            String?
  tradeName           String?
  legalName           String
  isCustomer          Boolean    @default(false)
  isSupplier          Boolean    @default(false)
  isTransporter       Boolean    @default(false)
  email               String?
  phone               String?
  mobile              String?
  billingEmail        String?
  fiscalEmail         String?
  simplesNacional     Boolean    @default(false)
  publicAgency        Boolean    @default(false)
  stateRegStatus      String?
  stateRegNumber      String?
  municipalReg        String?
  suframaReg          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  notes               String?
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@index([userId])
  @@index([userId, isCustomer])
  @@index([userId, isSupplier])
  @@index([userId, active])
}

enum PersonType {
  PESSOA_FISICA
  PESSOA_JURIDICA
  ESTRANGEIRA
}

model FinancialAccount {
  id            String      @id @default(cuid())
  userId        String
  name          String
  type          AccountType
  bankName      String?
  agency        String?
  accountNumber String?
  holderType    HolderType  @default(PESSOA_JURIDICA)
  canReceive    Boolean     @default(true)
  canPay        Boolean     @default(true)
  balance       Decimal     @default(0) @db.Decimal(14, 2)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@index([userId])
  @@index([userId, active])
}

enum AccountType {
  CHECKING
  CASH_BOX
  CREDIT_CARD
  INVESTMENT
  SAVINGS
  AUTO_RECEIPT
  OTHER
}

enum HolderType {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

model FinancialCategory {
  id          String       @id @default(cuid())
  userId      String
  type        CategoryType
  description String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@index([userId])
  @@index([userId, type])
}

enum CategoryType {
  REVENUE
  EXPENSE
}

model CostCenter {
  id        String   @id @default(cuid())
  userId    String
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@unique([userId, code])
  @@index([userId])
}

// ─── ERP — Payables ───────────────────────────────────────────

model Payable {
  id             String        @id @default(cuid())
  userId         String
  partyId        String?
  party          Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  accountId      String?
  account        FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  description    String
  amount         Decimal            @db.Decimal(14, 2)
  competenceDate DateTime
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?
  recurrence     String?
  referenceCode  String?
  notes          String?
  status         PayableStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attachments      Attachment[]
  bankTransactions BankTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([partyId])
}

enum PayableStatus {
  OPEN
  SCHEDULED
  PAID
  OVERDUE
}

// ─── ERP — Receivables ────────────────────────────────────────

model Receivable {
  id              String           @id @default(cuid())
  userId          String
  partyId         String?
  party           Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId    String?
  costCenter      CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  accountId       String?
  account         FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type            ReceivableType   @default(SERVICO)
  description     String
  amount          Decimal          @db.Decimal(14, 2)
  competenceDate  DateTime
  dueDate         DateTime
  receivedAt      DateTime?
  receivingMethod String?
  recurrence      String?
  referenceCode   String?
  notes           String?
  status          ReceivableStatus @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  attachments      Attachment[]
  bankTransactions BankTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([partyId])
}

enum ReceivableType {
  SERVICO
  PRODUTO
  DIVERSA
}

enum ReceivableStatus {
  OPEN
  SCHEDULED
  RECEIVED
  OVERDUE
}

// ─── ERP — Chat ───────────────────────────────────────────────

model ChatThread {
  id        String       @id @default(cuid())
  userId    String       @unique
  subject   String       @default("Suporte Financeiro")
  status    ThreadStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderType SenderType
  content    String
  createdAt  DateTime   @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

enum SenderType {
  CLIENT
  OPERATOR
  SYSTEM
}

// ─── Liba+ AI ─────────────────────────────────────────────────

model AiConversation {
  id        String          @id @default(cuid())
  userId    String
  title     String
  status    String          @default("ACTIVE")
  messages  AiMessage[]
  actions   AiDraftAction[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // USER, ASSISTANT, SYSTEM
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

// ─── Attachments ──────────────────────────────────────────────

model Attachment {
  id           String      @id @default(cuid())
  userId       String
  payableId    String?
  payable      Payable?    @relation(fields: [payableId], references: [id], onDelete: Cascade)
  receivableId String?
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  filename     String
  fileUrl      String
  fileType     String   // "invoice", "fiscal_doc", "other"
  description  String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([payableId])
  @@index([receivableId])
}

// ─── Bank reconciliation ──────────────────────────────────────

model BankImportBatch {
  id           String            @id @default(cuid())
  userId       String
  accountId    String?
  filename     String
  importedAt   DateTime          @default(now())
  transactions BankTransaction[]

  @@index([userId])
}

model BankTransaction {
  id           String          @id @default(cuid())
  batchId      String
  batch        BankImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId       String
  accountId    String?
  date         DateTime
  amount       Decimal         @db.Decimal(15, 2)
  description  String
  type         String          // CREDIT or DEBIT
  externalId   String?
  reconciled   Boolean         @default(false)
  payableId    String?
  payable      Payable?        @relation(fields: [payableId], references: [id], onDelete: SetNull)
  receivableId String?
  receivable   Receivable?     @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([batchId])
  @@unique([batchId, externalId])
}

model AiDraftAction {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  type           String         // create_supplier, create_customer, create_payable, create_receivable, create_category, create_cost_center
  status         String         @default("DRAFT") // DRAFT, APPROVED, REJECTED, EXECUTED, FAILED
  payload        Json
  errorMessage   String?
  targetId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([conversationId])
  @@index([userId])
  @@index([userId, status])
}
