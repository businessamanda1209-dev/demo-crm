# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/demo_crm
# Supabase: Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Auth/API keys
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# Vercel production URL, for example:
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chatwoot support widget (optional — leave blank to disable)
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://your-chatwoot.example.com
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=your-token-here
